+import hashlib,json,os,re,time,threading,urllib.request,urllib.error,uuid
+from pathlib import Path
+from io import BytesIO
+from urllib.parse import urlparse,quote
+from PIL import Image
+from .base import ImageProvider
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self,*args,**kwargs):return None
+
+def is_toapis(base):
+    try:
+        u=urlparse(base)
+        return u.scheme=='https' and u.hostname in ('toapis.com','toapis.cn') and u.path in ('','/','/v1','/v1/') and not (u.username or u.password or u.query or u.fragment or u.port)
+    except ValueError:return False
+
+class ToAPIsImageProvider(ImageProvider):
+    _locks={};_guard=threading.Lock()
+    def __init__(self,api_key,api_base='https://toapis.cn',model='gpt-image-2-vip',quality='low',state_dir=None):
+        if not is_toapis(api_base):raise ValueError('Use a ToAPIs HTTPS origin or /v1 base')
+        if model not in ('gpt-image-2','gpt-image-2-vip'):raise ValueError('This preview supports gpt-image-2 and gpt-image-2-vip only')
+        if quality not in ('low','medium','high','auto'):raise ValueError('Invalid quality tier')
+        self.key=api_key;self.origin='https://'+urlparse(api_base).hostname;self.model=model
+        self.quality='low' if quality=='auto' else quality
+        self.state=Path(state_dir or os.environ.get('TOAPIS_STATE_DIR','state/toapis'))
+        self.state.mkdir(parents=True,exist_ok=True)
+        self.http=urllib.request.build_opener(NoRedirect())
+        self.last_receipt=None
+    def _json(self,path,body=None,content_type='application/json'):
+        data=json.dumps(body).encode() if isinstance(body,dict) else body
+        req=urllib.request.Request(self.origin+'/v1/'+path,data=data,headers={'Authorization':'Bearer '+self.key,'Content-Type':content_type},method='POST' if data is not None else 'GET')
+        with self.http.open(req,timeout=60) as r:return json.load(r)
+    def _save(self,path,data):
+        temp=path.with_suffix('.'+uuid.uuid4().hex+'.tmp');temp.write_text(json.dumps(data,ensure_ascii=False,indent=2),encoding='utf-8');os.replace(temp,path)
+    def _upload(self,image):
+        buf=BytesIO();image.save(buf,format='PNG');raw=buf.getvalue()
+        if len(raw)>10000000:raise ValueError('Reference PNG exceeds 10 MB')
+        boundary='ToAPIs'+uuid.uuid4().hex
+        body=(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="reference.png"\r\nContent-Type: image/png\r\n\r\n'.encode()+raw+f'\r\n--{boundary}--\r\n'.encode())
+        data=self._json('uploads/images',body,'multipart/form-data; boundary='+boundary)
+        url=data.get('data',{}).get('url')
+        if not isinstance(url,str) or not url.startswith('https://'):raise RuntimeError('No HTTPS reference URL returned')
+        return url
+    def generate_image(self,prompt,ref_images=None,aspect_ratio='16:9',resolution='1K',enable_thinking=False,thinking_budget=0):
+        if not re.fullmatch(r'\d+:\d+',aspect_ratio):raise ValueError('Use a ratio such as 16:9')
+        if resolution.upper() not in ('1K','2K','4K'):raise ValueError('Invalid resolution')
+        refs=ref_images or []
+        if len(refs)>6:raise ValueError('This preview accepts at most 6 references')
+        hashes=[]
+        for im in refs:
+            b=BytesIO();im.save(b,format='PNG');hashes.append(hashlib.sha256(b.getvalue()).hexdigest())
+        params={'model':self.model,'prompt':prompt,'size':aspect_ratio,'resolution':resolution.lower(),'n':1,'response_format':'url'}
+        if self.model.endswith('-vip'):params['quality']=self.quality
+        fingerprint=hashlib.sha256(json.dumps([params,hashes,os.getenv('TOAPIS_RUN_ID','default'),hashlib.sha256(self.key.encode()).hexdigest()],sort_keys=True).encode()).hexdigest()
+        path=self.state/(fingerprint+'.json')
+        with self._guard:lock=self._locks.setdefault(str(path.resolve()),threading.Lock())
+        with lock:
+            existing=json.loads(path.read_text(encoding='utf-8')) if path.exists() else None
+            if existing and not existing.get('task_id'):raise RuntimeError('A prior POST may have been accepted. Check Task Logs before starting a new run.')
+            receipt=existing or {'state':'submitting','request':params,'reference_sha256':hashes,'task_id':None}
+            if not existing:
+                urls=[self._upload(im) for im in refs]
+                body={**params}
+                if urls:body['reference_images']=urls
+                # Create a durable uncertain-submission record before POST. No POST retry.
+                try:
+                    with path.open('x',encoding='utf-8') as f:json.dump(receipt,f,ensure_ascii=False)
+                except FileExistsError:raise RuntimeError('Another process started this request; inspect its receipt')
+                try:task=self._json('images/generations',body)
+                except Exception:raise RuntimeError('Submission response unavailable; inspect Task Logs before any new POST')
+                task_id=task.get('id') or task.get('task_id')
+                if not task_id:raise RuntimeError('No task ID returned; reconcile Task Logs before generating again')
+                receipt.update({'task_id':task_id,'state':'submitted'});self._save(path,receipt)
+                print(json.dumps({'event':'submitted','task_id':task_id,'model':self.model}),flush=True)
+            task_id=receipt['task_id'];deadline=time.monotonic()+600
+            while time.monotonic()<deadline:
+                try:task=self._json('images/generations/'+quote(task_id,safe=''))
+                except urllib.error.HTTPError as e:
+                    if e.code not in (429,503):raise
+                    time.sleep(8);continue
+                status=task.get('status')
+                if status in ('failed','cancelled','canceled','error'):
+                    receipt.update({'state':status});self._save(path,receipt);raise RuntimeError('Task failed; ID '+task_id)
+                if status=='completed':
+                    data=(task.get('result') or {}).get('data') or []
+                    url=data[0].get('url') if data else None
+                    if not url or not url.startswith('https://'):raise RuntimeError('Completed task has no HTTPS result: '+task_id)
+                    with self.http.open(urllib.request.Request(url),timeout=60) as r:
+                        mime=r.headers.get('content-type','')
+                        if not mime.startswith('image/'):raise RuntimeError('Result is not an image')
+                        raw=r.read(64*1024*1024+1)
+                    if len(raw)>64*1024*1024:raise RuntimeError('Result image exceeds download limit')
+                    image=Image.open(BytesIO(raw));image.load()
+                    receipt.update({'state':'completed','pixels':list(image.size),'output_sha256':hashlib.sha256(raw).hexdigest(),'billing':task.get('billing'),'cost':task.get('cost')})
+                    self._save(path,receipt);self.last_receipt=receipt
+                    return image
+                time.sleep(8)
+            raise RuntimeError('Observation timed out; resume task '+task_id+' before any new POST')
